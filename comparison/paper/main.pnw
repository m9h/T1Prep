\subsection{FastSurfer--T1Prep concordance on sub-1003}

<<concordance_fig, echo=False, results='hidden', fig=True, width='0.9\\linewidth', caption='DK ROI volume (FastSurfer VINN) vs cortical thickness (T1Prep CAT-Surface) for DLBS sub-1003 across three waves.'>>=
import sys; sys.path.insert(0, r'/home/mhough/dev/T1Prep/comparison/paper')
from paper_helpers import load_all
import matplotlib.pyplot as plt
d = load_all()
fs, t1p = d['fs'], d['t1p']
fig, ax = plt.subplots(figsize=(6.5, 4.5))
if fs.empty or t1p.empty:
    ax.text(0.5, 0.5, 'data pending', ha='center', va='center', transform=ax.transAxes)
    ax.axis('off')
else:
    SUBJECT = 'sub-1003'
    fs_sub = fs[(fs['subject'] == SUBJECT) & (fs['tool'] == 'aseg+DKT.VINN')]
    t1_sub = t1p[(t1p['subject'] == SUBJECT) & (t1p['tool'] == 't1prep_thickness')]
    for w, m in zip(sorted(fs_sub['session'].unique()), ['o', 's', '^']):
        fs_w = fs_sub[fs_sub['session'] == w].set_index('region')['volume_mm3']
        t1_w = t1_sub[t1_sub['session'] == w].set_index('region')['thickness_mm']
        common = sorted(set(fs_w.index) & set(t1_w.index))
        if common:
            ax.scatter([fs_w[r] for r in common], [t1_w[r] for r in common],
                       alpha=0.6, marker=m, label=w)
    ax.set_xlabel('FastSurfer DK ROI volume (mm$^3$)')
    ax.set_ylabel('T1Prep DK ROI mean thickness (mm)')
    ax.legend()
    fig.tight_layout()
@

